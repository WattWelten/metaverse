      "target": "api::asset.asset"
    },
    "audioBeacons": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::audio-beacon.audio-beacon"
    },
    "portals": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::portal.portal"
    },
    "zones": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::zone.zone"
    },
    "ui": {
      "type": "json"
    },
    "publishedAt": {
      "type": "datetime"
    }
  }

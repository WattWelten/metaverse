{
  "name": "wattwelten-metaverse",
  "version": "0.1.0",
  "private": true,
  "description": "WattWelten Metaverse - Three.js WebXR Multiplayer Platform",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --concurrency 14",
    "dev:client": "turbo run dev --filter=@metaverse/web",
    "dev:server": "turbo run dev --filter=@metaverse/server",
    "dev:all": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:progress": "tsx scripts/test-with-progress.ts test",
    "test:heartbeat": "powershell -ExecutionPolicy Bypass -File scripts/test-with-heartbeat.ps1 test",
    "e2e": "turbo run e2e",
    "e2e:progress": "tsx scripts/test-with-progress.ts e2e",
    "e2e:heartbeat": "powershell -ExecutionPolicy Bypass -File scripts/test-with-heartbeat.ps1 e2e",
    "test:e2e:dev": "cd apps/web && cross-env BASE_URL=http://localhost:5173 pnpm exec playwright test",
    "test:e2e:ui": "cd apps/web && cross-env BASE_URL=http://localhost:5173 pnpm exec playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "release": "changeset publish",
    "changeset": "changeset",
    "preview": "turbo run preview",
    "clean": "turbo run clean && rm -rf node_modules",
    "update-deps": "node scripts/update-deps.js",
    "import-template": "node scripts/import-template.js",
    "assets:import": "tsx scripts/import-assets.ts",
    "assets:professional": "tsx scripts/professional-assets.ts",
    "assets:demo": "tsx scripts/create-demo-assets-simple.ts",
    "assets:optimize": "tsx scripts/optimize-assets.ts",
    "assets:attr": "tsx scripts/generate-attribution.ts",
    "assets:budget": "tsx scripts/check-asset-budget.ts",
    "templates:download": "tsx scripts/download-landscape-templates.ts",
    "templates:validate": "tsx scripts/validate-templates.ts",
    "optimize:all": "tsx scripts/optimize-and-test.ts",
    "pipeline:full": "pnpm templates:download && pnpm assets:professional && pnpm optimize:all",
    "pipeline:auto": "tsx scripts/auto-pipeline.ts",
    "status": "tsx scripts/generate-status-report.ts",
    "setup:decoders": "tsx scripts/setup-decoders.ts",
    "setup:env": "tsx scripts/setup-env.ts",
    "setup:template:watt-eco": "tsx scripts/setup-template-watt-eco.ts",
    "auto:setup:option-a": "tsx scripts/auto-setup-option-a.ts",
    "dev:eco": "cross-env VITE_TEMPLATE_ID=watt-eco pnpm -w dev",
    "setup:templates": "tsx scripts/scan-templates.ts",
    "analyze:bundle": "tsx scripts/analyze-bundle.ts",
    "validate": "tsx scripts/validate-build.ts all",
    "validate:types": "tsx scripts/validate-build.ts types",
    "validate:lint": "tsx scripts/validate-build.ts lint",
    "validate:build": "tsx scripts/validate-build.ts build",
    "validate:tests": "tsx scripts/validate-build.ts test",
    "validate:ci": "tsx scripts/validate-build.ts all",
    "smoke": "node scripts/smoke-all.mjs",
    "smoke:rtc": "node scripts/smoke-rtc.mjs",
    "smoke:yws": "node scripts/smoke-yws.mjs",
    "smoke:strapi": "node scripts/smoke-strapi.mjs",
    "audit": "node scripts/audit-mvp.mjs",
    "audit:bash": "bash .audit/mvp-branch-audit.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "adm-zip": "^0.5.16",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "globals": "^15.14.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "prettier": "^3.7.4",
    "tsx": "^4.19.2",
    "turbo": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "ws": "^8.18.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.11.1",
    "pnpm": ">=8.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.4",
    "three-pathfinding": "^1.3.0",
    "troika-three-text": "^0.52.4",
    "zod": "^4.3.5"
  }
}

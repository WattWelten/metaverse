{
  "name": "wattwelten-metaverse",
  "version": "0.1.0",
  "private": true,
  "description": "WattWelten Metaverse - Three.js WebXR Multiplayer Platform",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@metaverse/web",
    "dev:server": "turbo run dev --filter=@metaverse/server",
    "dev:all": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "release": "changeset publish",
    "changeset": "changeset",
    "preview": "turbo run preview",
    "clean": "turbo run clean && rm -rf node_modules",
    "update-deps": "node scripts/update-deps.js",
    "import-template": "node scripts/import-template.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "adm-zip": "^0.5.16",
    "concurrently": "^9.2.1",
    "globals": "^15.14.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "prettier": "^3.7.4",
    "tsx": "^4.19.2",
    "turbo": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.11.1",
    "pnpm": ">=8.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}

{
  "name": "wattwelten-metaverse",
  "version": "0.1.0",
  "private": true,
  "description": "WattWelten Metaverse - Three.js WebXR Multiplayer Platform",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "release": "changeset publish",
    "changeset": "changeset",
    "preview": "turbo run preview",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.11.5",
    "prettier": "^3.2.4",
    "turbo": "^1.12.3",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.11.1",
    "pnpm": ">=8.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}


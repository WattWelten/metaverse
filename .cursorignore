# Erlaube wichtige Root-Configs und Code-Dateien
!turbo.json
!pnpm-workspace.yaml
!vitest.config.ts
!package.json
!package-lock.json
!yarn.lock
!pnpm-lock.yaml
!tsconfig.json
!jsconfig.json
!pyproject.toml
!setup.py
!requirements.txt
!Pipfile
!Pipfile.lock
!poetry.lock

# WICHTIG: Code-Dateien werden NIEMALS ausgeschlossen
# Alle Source-Code-Dateien bleiben indexiert:
# - *.py, *.ts, *.tsx, *.js, *.jsx, *.vue, *.svelte
# - *.rs, *.go, *.java, *.kt, *.swift
# - *.html, *.css, *.scss, *.less
# - *.json, *.yaml, *.yml, *.toml, *.xml
# - *.md, *.txt, *.rst (Dokumentation)
# - Dockerfile, docker-compose.yml
# - *.test.*, *.spec.* (Tests)
# - *.config.*, *.conf (Konfigurationen)

# Nur große Binärdateien und Artefakte werden ausgeschlossen

# Global .cursorignore · WattWeiser
# Verhindert Serialisierungsfehler in Cursor durch Ausschluss großer/unnötiger Dateien
#
# QUALITÄTSSICHERUNG:
# - Alle Code-Dateien bleiben indexiert (keine Qualitätseinbußen)
# - Dokumentation bleibt indexiert (wichtig für Kontext)
# - Konfigurationsdateien bleiben indexiert
# - Nur große Binärdateien, Artefakte und Dependencies werden ausgeschlossen
# - Kleine CSV/Test-Dateien bleiben verfügbar

# Node.js / JavaScript / TypeScript
node_modules/
dist/
build/
.next/
.turbo/
.nuxt/
.output/
coverage/
.cache/
.npm/
.yarn/
.pnp/
.pnp.js

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
cython_debug/
.venv/
venv/
ENV/
env/
.conda/

# Große Daten-Dateien (können Serialisierungsfehler verursachen)
# WICHTIG: Kleine CSV/Test-Dateien werden NICHT ausgeschlossen für Qualität
*.parquet
# CSV: Nur große Dateien ausschließen (kleine Test-Daten bleiben)
# *.csv  # AUSKOMMENTIERT: Kleine CSV-Dateien können wichtig sein
*.xlsx
*.xls
*.xlsm
*.ods
*.pdf
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.rar
*.7z
*.gz
*.bz2

# Logs und Reports
logs/
*.log
*.log.*
reports/
*.report
*.out

# Environment & Secrets
.env
.env.*
!.env.example
!.env.template
*.key
*.pem
*.p12
*.pfx
secrets/
.secrets/

# Dokumentation (wichtig für Kontext - wird NICHT ausgeschlossen)
# docs/**  # AUSKOMMENTIERT: Dokumentation ist wichtig für Cursor-Kontext und Qualität
# Alle Dokumentationsdateien bleiben indexiert für besseren Kontext

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# OS-spezifische Dateien
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
System Volume Information/
$RECYCLE.BIN/
.directory

# Temporäre Dateien
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~
.cache/
.temp/
tmp/
temp/

# Build-Artefakte
*.o
*.a
*.lib
*.dll
*.exe
*.bin
*.class
*.jar
*.war
*.ear

# Docker (Config-Dateien sind wichtig)
# .dockerignore  # AUSKOMMENTIERT: Kann nützlich sein
docker-compose.override.yml
# *.dockerignore  # AUSKOMMENTIERT: Kann nützlich sein

# Railway
.railway/

# Streamlit (Config kann wichtig sein)
# .streamlit/  # AUSKOMMENTIERT: Config-Dateien können wichtig sein
.streamlit/secrets.toml
.streamlit/*.key

# Cursor interne Verzeichnisse (können Serialisierungsprobleme verursachen)
.cursor/
.cursor-cache/
.cursor-index/

# Git (kann sehr groß sein und Serialisierungsfehler verursachen)
.git/
.git/objects/
.git/logs/
.git/hooks/
.git/refs/
.git/index
.git/packed-refs

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# Database
*.db

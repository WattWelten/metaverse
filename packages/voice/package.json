{
  "name": "@metaverse/voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zone-router": {
      "types": "./dist/zone-router.d.ts",
      "default": "./dist/zone-router.js"
    },
    "./zone-engine": {
      "types": "./dist/zone-engine.d.ts",
      "default": "./dist/zone-engine.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "lint": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@metaverse/audio": "workspace:*",
    "@metaverse/net": "workspace:*",
    "livekit-client": "^2.5.0",
    "simple-peer": "^9.11.1"
  },
  "devDependencies": {
    "@metaverse/eslint-config": "workspace:*",
    "@metaverse/tsconfig": "workspace:*",
    "@types/node": "^25.0.3",
    "@types/simple-peer": "^9.11.8",
    "typescript": "^5.9.3",
    "vitest": "^1.0.0"
  }
}

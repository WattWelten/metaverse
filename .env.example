# WattWelten Metaverse - Environment Variables

# Feature Flags
VITE_XR_ENABLED=true
VITE_VE_ENABLED=false
VITE_AI_ENABLED=false
VITE_VOICE_ENABLED=false
VITE_CMS_PROVIDER=local
VITE_TEMPLATE_ID=watt-eco
VITE_MULTIPLAYER_ENABLED=false
VITE_AMBIENT_AUDIO_ENABLED=false

# AI / wattos_plattform Integration
VITE_WATTOS_BASE_URL=
VITE_WATTOS_WS_URL=
VITE_WATTOS_API_KEY=
VITE_WATTOS_TENANT=

# Voice (LiveKit)
VITE_LIVEKIT_URL=
VITE_LIVEKIT_TOKEN_ENDPOINT=${VITE_WATTOS_BASE_URL}/voice/token
VITE_SHARE_ENABLED=true

# CMS / Strapi Integration
VITE_CMS_BASE_URL=
VITE_CMS_TOKEN=

# Ready Player Me
VITE_READY_PLAYER_ME_API_KEY=
VITE_READY_PLAYER_ME_AVATAR_URL=

# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173

# Debug
VITE_DEBUG_ENABLED=false

# Whiteboard
VITE_WHITEBOARD_ENABLED=true
VITE_YWS_URL=ws://localhost:1234

# Navigation Debug
VITE_NAV_DEBUG=false

# Voice (optional)
VITE_VOICE_ENABLED=false
VITE_LIVEKIT_URL=
VITE_WATTOS_BASE_URL=http://localhost:8080

# LiveKit Cloud (für SFU)
LIVEKIT_URL=wss://<your>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Y-WebSocket (integriert in apps/server)
YWS_ENABLED=true

# Sentry
SENTRY_DSN=

# NextAuth
NEXTAUTH_URL=http://localhost:5173
NEXTAUTH_SECRET=

# Strapi
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=

# Y-WebSocket Port (integriert in apps/server)
YWS_PORT=5179

# E2E Testing
E2E_URL=http://localhost:5173
E2E_ROOM=plaza

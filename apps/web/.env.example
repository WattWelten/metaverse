# Server Configuration
VITE_SERVER_URL=http://localhost:3001

# Feature Flags
VITE_MULTIPLAYER_ENABLED=false
VITE_VOICE_ENABLED=false
VITE_XR_ENABLED=true
VITE_AI_ENABLED=false
VITE_WHITEBOARD_ENABLED=true
VITE_AMBIENT_AUDIO_ENABLED=true
VITE_SHARE_ENABLED=true

# Template Configuration
VITE_TEMPLATE_ID=watt-eco
VITE_TEMPLATE_SWITCH=true

# Ready Player Me Integration
# Get your API key from: https://readyplayer.me/developers
# Optional: Frame API works without API key, but API key enables better integration
VITE_READY_PLAYER_ME_API_KEY=

# Avaturn Integration (optional)
VITE_AVATURN_ENABLED=false

# Audio Configuration
VITE_AUDIO_TEST_MODE=false

# CMS Configuration
VITE_CMS_PROVIDER=local
VITE_CMS_URL=
VITE_CMS_TOKEN=

# Voice Configuration (LiveKit)
VITE_LIVEKIT_URL=wss://your-livekit-server.com
VITE_LIVEKIT_API_KEY=
VITE_LIVEKIT_API_SECRET=

# WattOS Integration (optional)
VITE_WATTOS_BASE_URL=https://api.wattos.local
VITE_WATTOS_WS_URL=wss://api.wattos.local/realtime
VITE_WATTOS_API_KEY=
VITE_WATTOS_TENANT=

# Debug Flags
VITE_DEBUG_ENABLED=false
VITE_NAV_DEBUG=false
VITE_ZONE_DEBUG=false
VITE_LOCO_DEBUG=false
